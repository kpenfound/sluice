{
  "manifest_version": 3,
  "name": "Sluice",
  "version": "0.0.0",
  "description": "Makes every tab disposable. Queued items decay on a schedule.",
  "browser_specific_settings": {
    "gecko": {
      "id": "sluice@kylepenfound.com",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["tabs", "history", "storage", "alarms"],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Add current tab"
    },
    "open-launcher": {
      "description": "Open launcher"
    }
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "action": {
    "default_title": "Sluice",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html"
  }
}
